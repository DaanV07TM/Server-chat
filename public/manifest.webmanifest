{
  "name": "Server Chat · COSMIC",
  "short_name": "Chat",
  "description": "A modern community chat with an Ubuntu COSMIC-inspired design.",
  "start_url": "/?room=general",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#17111c",
  "theme_color": "#77216f",
  "orientation": "any",
  "icons": [
    {
      "src": "/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
